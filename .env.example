# Copie para .env e preencha. NUNCA versione o .env.
# Nome da plataforma (painel, título das cobranças no Mercado Pago). Basta trocar aqui.
BRAND_NAME=Operix
ENVIRONMENT=development
# Produção: DOMAIN=app.seudominio.com.br, ENVIRONMENT=production e as três URLs abaixo com https://DOMAIN
DOMAIN=
PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
POSTGRES_PASSWORD=troque-esta-senha

# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Chave AES-256 dos segredos de corretora. Gere com:
#   python -c "import base64,os; print('k1:' + base64.b64encode(os.urandom(32)).decode())"
# Guarde uma cópia fora do servidor: sem ela, as chaves cadastradas ficam ilegíveis.
ENCRYPTION_KEYS=

# Mercado Pago (Suas integrações > sua aplicação > Credenciais / Webhooks)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# cTrader Open API (forex). OPCIONAL: só para o botão "Conectar com cTrader" com um app da plataforma.
# Sem isso, cada cliente informa o próprio app (Client ID/Secret) e tokens no painel.
# Cadastre o app em https://openapi.ctrader.com/apps com o redirect {API_PUBLIC_URL}/api/v1/ctrader/callback
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=

# Administrador criado pelo seed (python -m app.seed)
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=

# Motor
WORKER_INTERVAL_SECONDS=20
SIGNAL_TTL_MINUTES=15
